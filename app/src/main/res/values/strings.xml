    <string name="builder_scheme_title">Which payload to build?</string>
    <string name="builder_scheme_subtitle">Both schemes are the same CVE-2026-43499 chain — they differ in vendor adaptation.</string>
    <string name="builder_scheme_universal">Universal</string>
    <string name="builder_scheme_universal_detail">Works on most GKI 6.6 devices. No vendor anti-root bypass, so it is the safe default outside vivo/iQOO.</string>
    <string name="builder_scheme_vivo">vivo / iQOO (vr.ko bypass)</string>
    <string name="builder_scheme_vivo_detail">Adds the vr.ko anti-root bypass. Required on vivo / iQOO, where the universal chain is blocked.</string>
